FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-value
# Only used if the database has no users; remove after the first successful start.
# INITIAL_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
SESSION_COOKIE_SECURE=1
DATABASE_DIR=/var/lib/pi-manager/instance
UPLOAD_DIR=/var/lib/pi-manager/uploads
PDF_DIR=/var/lib/pi-manager/pdf
BACKUP_DIR=/var/lib/pi-manager/backups
SETTINGS_FILE=/var/lib/pi-manager/settings.json
MAX_UPLOAD_MB=32
# Optional DingTalk/Vercel Blob values are configured in the application settings
# or as environment variables. Never commit real secrets to this file.
