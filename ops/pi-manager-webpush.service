[Unit]
Description=PI Manager Web Push Notification Worker
After=network-online.target pi-manager.service
Wants=network-online.target

[Service]
Type=simple
User=pi-manager
Group=pi-manager
WorkingDirectory=/opt/pi-manager/current
EnvironmentFile=/etc/pi-manager/pi-manager.env
EnvironmentFile=/etc/pi-manager/webpush.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pi-manager/venv/bin/python web_push_worker.py
Restart=on-failure
RestartSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi-manager

[Install]
WantedBy=multi-user.target
